{
  "name": "eblick/contao-trigger",
  "type": "contao-bundle",
  "description": "Time and condition based trigger framework for notifications and other things inside Contao Open Source CMS",
  "keywords": [
    "contao",
    "trigger",
    "time",
    "table",
    "automation",
    "notifications"
  ],
  "license": "LGPL-3.0",
  "authors": [
    {
      "name": "eBlick Medienberatung",
      "homepage": "https://eblick-medienberatung.de"
    },
    {
      "name": "Moritz Vondano",
      "homepage": "https://github.com/m-vo",
      "role": "developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "contao/core-bundle": "^5.7 || ^5.1",
    "symfony/expression-language": "^7.4",
    "symfony/stopwatch": "^7.4",
    "symfony/lock": "^7.4",
    "doctrine/dbal": "^3.7 || ^4.3"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.4",
    "contao/manager-plugin": "^2.0",
    "terminal42/notification_center": "^2.0",
    "phpunit/phpunit": "^12.4",
    "contao/test-case": "^5.7"
  },
  "suggest": {
    "terminal42/notification_center": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EBlick\\ContaoTrigger\\": "src/",
      "EBlick\\ContaoTrigger\\Test\\": "tests/"
    }
  },
  "extra": {
    "contao-manager-plugin": "EBlick\\ContaoTrigger\\ContaoManager\\Plugin",
    "bamarni-bin": {
      "bin-links": false,
      "target-directory": "tools"
    }
  },
  "scripts": {
    "cs": [
      "tools/ecs/vendor/bin/ecs check src tests --config tools/ecs/config/default.php --fix"
    ],
    "tests": [
      "vendor/bin/phpunit --fail-on-phpunit-notice"
    ]
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true,
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "contao-community-alliance/composer-plugin": true,
      "php-http/discovery": false
    }
  }
}
